# =====================================================================
# WhatsApp AI Business Agent - environment variables (TEMPLATE)
# Copy this file to .env and fill in real values:
#     Copy-Item .env.example .env
# .env is git-ignored. NEVER commit real secrets.
# =====================================================================

# ---------- App ----------
APP_ENV=development              # development | production
APP_NAME="WhatsApp AI Business Agent"
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173   # allowed CORS origin for the dashboard

# ---------- PostgreSQL ----------
POSTGRES_USER=wa_agent
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=wa_agent
POSTGRES_HOST=127.0.0.1          # not "localhost": avoids a 2s IPv6 delay on Windows. "postgres" inside Docker Compose
POSTGRES_PORT=5433   # 5432 is used by another local project
# Built by the backend from the values above if left empty:
DATABASE_URL=

# ---------- Auth (dashboard login) ----------
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRE_MINUTES=60
ADMIN_EMAIL=admin@example.com    # first admin user, created by the seed script
ADMIN_PASSWORD=change-me

# ---------- Gemini AI (Stage 6) ----------
# Free key: https://aistudio.google.com/apikey  (do NOT enable billing without approval)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash         # stable + free tier. 2.5-flash is deprecated (Dec 1, 2026)

GEMINI_TIMEOUT_SECONDS=30
# NOTE: on the FREE tier Google may use prompts to improve its products. Use test data only;
# real customer data needs the paid tier (requires approval).

# ---------- WhatsApp Cloud API (Stage 5) ----------
# true = never call Meta; outgoing messages are only logged to the database
WA_MOCK_MODE=true
WA_ENV=test                      # test (Meta test number) | production (real business number)
WA_GRAPH_API_VERSION=v27.0         # latest per Meta changelog (Nov 2026)
WA_PHONE_NUMBER_ID=              # from Meta App > WhatsApp > API Setup
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=                 # temporary (24h) for test; System User permanent token for production
WA_APP_SECRET=                   # Meta App > Settings > Basic > App secret. Verifies X-Hub-Signature-256
WA_VERIFY_TOKEN=pick-any-random-string   # must match what you type in Meta's webhook settings

# ---------- n8n (Stage 7) ----------
N8N_BASE_URL=http://127.0.0.1:5690
N8N_PORT=5690
N8N_ENCRYPTION_KEY=generate-a-random-32-char-string
N8N_API_KEY=                     # n8n Settings > n8n API (lets the dashboard read executions)
BACKEND_INTERNAL_API_KEY=generate-another-random-string  # n8n -> backend shared secret

# ---------- Notifications ----------
SALES_NOTIFY_EMAIL=sales@example.com
ADMIN_ALERT_EMAIL=admin@example.com
