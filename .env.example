# =====================================================================
# WhatsApp AI Business Agent - environment variables (TEMPLATE)
# Copy this file to .env and fill in real values:
#     Copy-Item .env.example .env
# .env is git-ignored. NEVER commit real secrets.
# =====================================================================

# ---------- App ----------
# development | production
APP_ENV=development
APP_NAME="WhatsApp AI Business Agent"
BACKEND_PORT=8000
# allowed CORS origin for the dashboard
FRONTEND_URL=http://localhost:5173

# ---------- PostgreSQL ----------
POSTGRES_USER=wa_agent
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=wa_agent
# not "localhost": avoids a 2s IPv6 delay on Windows. "postgres" inside Docker Compose
POSTGRES_HOST=127.0.0.1
# 5432 is used by another local project
POSTGRES_PORT=5433
# Built by the backend from the values above if left empty:
DATABASE_URL=

# ---------- Auth (dashboard login) ----------
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRE_MINUTES=60
# first admin user, created by the seed script
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# ---------- Gemini AI (Stage 6) ----------
# Free key: https://aistudio.google.com/apikey  (do NOT enable billing without approval)
GEMINI_API_KEY=
# stable + free tier. 2.5-flash is deprecated (Dec 1, 2026)
GEMINI_MODEL=gemini-3.8-flash

GEMINI_TIMEOUT_SECONDS=30
# NOTE: on the FREE tier Google may use prompts to improve its products. Use test data only;
# real customer data needs the paid tier (requires approval).

# ---------- WhatsApp Cloud API (Stage 5) ----------
# true = never call Meta; outgoing messages are only logged to the database
WA_MOCK_MODE=true
# test (Meta test number) | production (real business number)
WA_ENV=test
# latest per Meta changelog (Nov 2026)
WA_GRAPH_API_VERSION=v27.0
# from Meta App > WhatsApp > API Setup
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
# temporary (24h) for test; System User permanent token for production
WA_ACCESS_TOKEN=
# Meta App > Settings > Basic > App secret. Verifies X-Hub-Signature-256
WA_APP_SECRET=
# must match what you type in Meta's webhook settings
WA_VERIFY_TOKEN=pick-any-random-string

# ---------- n8n (Stage 7) ----------
N8N_BASE_URL=http://127.0.0.1:5690
N8N_PORT=5690
N8N_ENCRYPTION_KEY=generate-a-random-32-char-string
# n8n Settings > n8n API (lets the dashboard read executions)
N8N_API_KEY=
# n8n -> backend shared secret
BACKEND_INTERNAL_API_KEY=generate-another-random-string

# ---------- Notifications ----------
SALES_NOTIFY_EMAIL=sales@example.com
ADMIN_ALERT_EMAIL=admin@example.com

# ---------- Docker / deployment (Stage 11) ----------
# Local Docker stack: dashboard port on this computer
DASHBOARD_PORT=8080
# Pinned n8n version (tested with the workflows)
N8N_IMAGE=n8nio/n8n:2.46.4
# Run 'python -m app.seed' on backend start (only inserts missing rows)
SEED_ON_START=true
# Production only (docker-compose.prod.yml): your domains, DNS A-records -> server IP
DASHBOARD_DOMAIN=dashboard.example.com
N8N_DOMAIN=n8n.example.com
# Email for Let's Encrypt certificate notices
ACME_EMAIL=you@example.com
